# MoneyTrade AI — local environment. This file is gitignored; keep your secrets here.

# 1) AI chat is powered by a LOCAL, FREE Ollama server — no API key needed.
#    Make sure Ollama is running (`ollama serve`) and the model is pulled.
#    Change the model here if you want (e.g. llama3.2, mistral, qwen2.5-coder:7b).
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://127.0.0.1:11434

# 2) Postgres connection — database name is "moneytrade".
#    Replace REPLACE_WITH_YOUR_PG_PASSWORD with your Postgres password.
#    If your Postgres username isn't "postgres", change that too.
DATABASE_URL=postgresql+psycopg2://postgres:rayen 123@localhost:5432/moneytrade

# 3) JWT signing secret (generated for you — fine to keep as-is).
JWT_SECRET_KEY=guJRHvKTRWp9DUDoBphTzyz1fwQPH0M6JRFJLwte6cQ1XTVRsuvBhyuvph4BZTnD

# Server config
PORT=5000
FLASK_DEBUG=false
